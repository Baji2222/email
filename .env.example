# ============================================================
# Network Switch Service Management System - Environment Config
# Copy this file to .env in /backend and /frontend as needed.
# NEVER commit the real .env file.
# ============================================================

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key must ONLY ever be used on the backend. Never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Backend server ----
PORT=4000
NODE_ENV=development

# ---- Email ----
# mock = safe local/dev mode, no real emails are sent (Chunk 1-4 default)
# gmail = real Gmail OAuth sending (enabled in Chunk 6)
EMAIL_PROVIDER=mock
EMAIL_FROM=bajivali916@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:4000/api
